{
  "name": "studyquest",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "ng serve --port 4220",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "e2e": "playwright test",
    "db:start": "supabase start -x postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "@supabase/supabase-js": "2.118.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supabase": "2.121.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
